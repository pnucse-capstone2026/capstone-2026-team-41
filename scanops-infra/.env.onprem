# ScanOps 온프레미스 — 외부 호출 0 구성
# 사용: cp .env.onprem.example .env.onprem  후 값 수정
#      docker compose -f docker-compose.onprem.yml --env-file .env.onprem up -d

# ── DB ──────────────────────────────────────────────────────────────────────
POSTGRES_DB=scanops
POSTGRES_USER=scanops
POSTGRES_PASSWORD=change-me

# ── 내부 인증 ───────────────────────────────────────────────────────────────
SCANOPS_API_KEY=onprem-local-key

# ── LLM (llm 프로파일에서만 사용) ───────────────────────────────────────────
# GGUF 파일이 있는 호스트 디렉토리와 파일명.
GGUF_DIR=/Users/kimsehan/Desktop/scanops/scanops-model/models
GGUF_FILE=Qwen3.5-9B-Q4_K_M.gguf
# 파인튜닝 어댑터(LoRA)를 얹는다. **이게 없으면 판정 4줄 서식이 안 나와 전부 미탐이 된다.**
# 내부 test 20건에서 저장된 v1 예측과 일치율 95.0%(19/20), 파싱 100% 확인
# (rebuild/out/lora_verify_fix.log).
LORA_ARG=--lora /models/adapter_v1_fix.gguf
LLAMA_CTX=4096
LLAMA_PARALLEL=1

# ── Joern ───────────────────────────────────────────────────────────────────
JOERN_IMAGE=hansekim31/scanops-joern-worker:final
JOERN_XMX=4g
JOERN_MEM_LIMIT=8g
JOERN_CHUNK=25
JOERN_CASE_TIMEOUT=90
SCANOPS_JOERN_TIMEOUT=120

# ── 하이브리드 정책 ─────────────────────────────────────────────────────────
# 실측 판정 = JOERN-NO-BETTER (CleanVul 240건 precision 0.5909 < 0.70,
# JOERN_HYBRID_REPORT_V4.md §4). Joern 은 판정에 관여하지 않고 evidence 로만 붙는다.
SCANOPS_HYBRID_POLICY=JOERN-NO-BETTER

# ── 외부 호출 차단 (전부 빈 값으로 두어야 한다) ─────────────────────────────
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# OAuth 는 비우면 Spring 부팅이 실패한다("Client id must not be empty") → 더미 값.
# 온프레미스는 사내 IdP/로컬 계정 전제.
GITHUB_OAUTH_CLIENT_ID=onprem-dummy
GITHUB_OAUTH_CLIENT_SECRET=onprem-dummy
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── 선택 서비스 (profiles) ──────────────────────────────────────────────────
QDRANT_URL=
ZAP_API_KEY=onprem-zap-key
